# NOTE: adapted from scipy/__config__.py.in

# this file is generated by tolomeo's build process
# it contains system_info results at the time of building this package.
from enum import Enum

__all__ = ["show_config"]
_built_with_meson = True


class DisplayModes(Enum):
    stdout = "stdout"
    dicts = "dicts"


def _cleanup(d):
    """
    Removes empty values in a `dict` recursively
    This ensures we remove values that Meson could not provide to CONFIG
    """
    if isinstance(d, dict):
        return { k: _cleanup(v) for k, v in d.items() if v != '' and _cleanup(v) != '' }
    else:
        return d


CONFIG = _cleanup(
    {
        "Compilers": {
            "c": {
                "name": "@C_COMP@",
                "linker": r"@C_COMP_LINKER_ID@",
                "version": "@C_COMP_VERSION@",
                "commands": r"@C_COMP_CMD_ARRAY@",
                "args": r"@C_COMP_ARGS@",
                "linker args": r"@C_COMP_LINK_ARGS@",
            },
            "fortran": {
                "name": "@FORTRAN_COMP@",
                "linker": r"@FORTRAN_COMP_LINKER_ID@",
                "version": "@FORTRAN_COMP_VERSION@",
                "commands": r"@FORTRAN_COMP_CMD_ARRAY@",
                "args": r"@FORTRAN_COMP_ARGS@",
                "linker args": r"@FORTRAN_COMP_LINK_ARGS@",
            },
        },
        "Machine Information": {
            "host": {
                "cpu": r"@HOST_CPU@",
                "family": r"@HOST_CPU_FAMILY@",
                "endian": r"@HOST_CPU_ENDIAN@",
                "system": r"@HOST_CPU_SYSTEM@",
            },
            "build": {
                "cpu": r"@BUILD_CPU@",
                "family": r"@BUILD_CPU_FAMILY@",
                "endian": r"@BUILD_CPU_ENDIAN@",
                "system": r"@BUILD_CPU_SYSTEM@",
            },
            "cross-compiled": "@CROSS_COMPILED@".lower() == "true",
        },
        "Build Dependencies": {
            "numpy": {
                "name": "@NUMPY_NAME@",
                "version": "@NUMPY_VERSION@",
                "detection method": "@NUMPY_TYPE_NAME@",
            },
        },
        "Python Information": {
            "path": r"@PYTHON_PATH@",
            "version": "@PYTHON_VERSION@",
        },
    },
)


def show_config(mode=DisplayModes.stdout.value):
    """
    Show libraries and system information on which tolomeo was built
    and is being used.

    Parameters
    ----------
    mode : {`'stdout'`, `'dicts'`}, optional.
        Indicates how to display the config information.
        `'stdout'` prints to console, `'dicts'` returns a dictionary
        of the configuration.

    Returns
    -------
    out : {`dict`, `None`}
        If mode is `'dicts'`, a dict is returned, else None

    Examples
    --------
    >>> import tolomeo
    >>> tolomeo.show_config()
    ... # formatted output is printed to the console

    >>> config_dict = tolomeo.show_config(mode='dicts')
    >>> list(config_dict.keys())
    ['Compilers', 'Machine Information', 'Build Dependencies', 'Python Information']
    """
    if mode == DisplayModes.stdout.value:
        import yaml
        print(yaml.dump(CONFIG))
    elif mode == DisplayModes.dicts.value:
        return CONFIG
    else:
        raise ValueError(
            f"Invalid `mode`, use one of: {', '.join([e.value for e in DisplayModes])}"
        )
