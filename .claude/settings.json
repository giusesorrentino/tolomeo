{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(spin test *)",
      "Bash(uv run --active pytest *)",
      "Bash(uv run pytest *)",
      "Bash(uv run python .tolomeo/scratch/*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)"
    ]
  }
}
